ErrorDocument 404 /shopnext/ShopNext-Beta/views/error/404.html
ErrorDocument 403 /shopnext/ShopNext-Beta/views/error/403.html
ErrorDocument 500 /shopnext/ShopNext-Beta/views/error/500.html
ErrorDocument 401 /shopnext/ShopNext-Beta/views/error/401.html

Options -MultiViews
RewriteEngine On

# Si la petición NO es para un archivo existente
RewriteCond %{REQUEST_FILENAME} !-f
# Si la petición NO es para un directorio existente
RewriteCond %{REQUEST_FILENAME} !-d

# CORRECCIÓN: Redirige todas las peticiones a index.php usando ?action=
# Ahora tu .htaccess y tu index.php hablarán el mismo "idioma".
RewriteRule ^(.*)$ index.php?action=$1 [L,QSA]

